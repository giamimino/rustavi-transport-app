{
  "expo": {
    "name": "rustavi-transport-app",
    "slug": "rustavi-transport-app",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "client",
    "userInterfaceStyle": "automatic",
    "ios": {
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
