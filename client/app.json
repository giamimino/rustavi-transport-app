{
  "expo": {
    "name": "rustavi-transport-app",
    "slug": "rustavi-transport-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rustavitransportapp",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "web",
      "ios",
      "android"
    ],
    "githubUrl": "https://github.com/giamimino/rustavi-transport-app",
    "icon": "./assets/images/splash-icon.png",
    "ios": {
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash-icon.png",
        "backgroundColor": "#2E2E2E"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gia22.portfolioapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-32x32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2E2E2E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
