{
  "name": "rustavi-transport",
  "version": "v0.0.1",
  "workspaces": [
    "client",
    "server"
  ],
  "description": "A mobile application for public transportation in Rustavi, Georgia. Provides offline access to bus routes, schedules, and transport information, with automatic data synchronization when an internet connection is available.",
  "homepage": "https://github.com/giamimino/rustavi-transport-app#readme",
  "bugs": {
    "url": "https://github.com/giamimino/rustavi-transport-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giamimino/rustavi-transport-app.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "gia miminoshvili",
  "scripts": {
    "client:start": "npm run start -w rustavi-transport-app",
    "client:android": "npm run android -w rustavi-transport-app",
    "client:ios": "npm run ios -w rustavi-transport-app",
    "client:web": "npm run web -w rustavi-transport-app",

    "lint:check": "concurrently \"npm run client:lint:check\" \"npm run server:lint:check\"",
    "lint:fix": "concurrently \"npm run client:lint:fix\" \"npm run server:lint:fix\"",
    "client:lint:check": "npm run lint -w rustavi-transport-app",
    "client:lint:fix": "npm run lint -w rustavi-transport-app -- --fix",
    "server:lint:check": "npm run lint -w rustavi-transport-server",
    "server:lint:fix": "npm run lint -w rustavi-transport-server -- --fix",

    "format:fix": "concurrently \"npm run client:format:fix\" \"npm run server:format:fix\"",
    "format:check": "concurrently \"npm run client:format:check\" \"npm run server:format:check\"",
    "client:format:check": "npm run format:check -w rustavi-transport-app",
    "client:format:fix": "npm run format:fix -w rustavi-transport-app",
    "server:format:check": "npm run format:check -w rustavi-transport-server",
    "server:format:fix": "npm run format:fix -w rustavi-transport-server"

  },
  "lint-staged": {
    "client/src/**/*.{js,jsx,ts,tsx}": [
      "eslint --config client/eslint.config.js",
      "prettier --write"
    ],
    "server/src/**/*.{js,jsx,ts,tsx}": [
      "eslint --config server/eslint.config.mjs",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@actions/github": "^9.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "~6.0.3"
  }
}
